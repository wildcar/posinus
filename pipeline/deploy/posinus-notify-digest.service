[Unit]
Description=Positive News: the daily one-line summary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=posinus-pipeline
Group=posinus-pipeline
SupplementaryGroups=posinus
UMask=0007
EnvironmentFile=/etc/posinus/pipeline.env
ExecStart=/usr/bin/python3 /opt/posinus/pipeline/notify.py --digest
NoNewPrivileges=true
PrivateTmp=true
