[Unit]
Description=Run the news publisher on the slot grid and between slots for retries

[Timer]
OnBootSec=12min
# Fire exactly on the publication slots (PUB_SLOTS in publisher.py), so a new
# issue appears at 09:00, not at 09:23. Keep in step with the code default.
OnCalendar=*-*-* 09,11,13,15,17,19,21,23:00:00 Europe/Moscow
# Between slots: retries of failed platforms, expiry, and catching up on a slot
# whose exact-minute run failed or found an empty queue.
OnCalendar=*-*-* *:15,45:00
AccuracySec=15s

[Install]
WantedBy=timers.target
