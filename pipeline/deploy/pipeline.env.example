# Positive News Evaluator config.
# Live copy: /etc/posinus/pipeline.env (root:posinus-pipeline, 0640 - it holds a token).
# Edits apply on the next timer run; no restart, no code change.

# Bearer token of model-router-mcp (AUTH_TOKEN from /opt/model-router-mcp/.env).
ROUTER_AUTH_TOKEN=fill-me

ROUTER_MCP_URL=http://127.0.0.1:8088/mcp
NEWS_DB_PATH=/var/lib/posinus/posinus.sqlite3
SELECTOR_NAME=news-evaluator
# Who the router bills for scoring. Empty falls back to SELECTOR_NAME. The
# preparer sends its own id (PREPARER_ROUTER_USER_ID) so the router's usage
# report tells scoring and retelling apart.
ROUTER_USER_ID=

# Model routing. EVALUATOR_MODEL pins one model; leave it EMPTY to let the
# router pick by EVALUATOR_PROVIDER / EVALUATOR_TIER hints (empty hints are
# not sent at all). The model that actually answered is recorded in each
# event's selector_version either way.
EVALUATOR_PROVIDER=deepseek
EVALUATOR_MODEL=deepseek-v4-pro
EVALUATOR_TIER=

# News per timer run.
EVALUATOR_BATCH=25

# Token budget per model call. It has to cover the model's REASONING tokens, not just the
# answer: deepseek-v4-pro spends ~950 completion tokens on one 20-axis evaluation, and when
# it hits the cap before writing content the provider returns an empty body. The log then
# says "DeepSeek returned an empty response". Raise this before suspecting the prompt.
EVALUATOR_MAX_TOKENS=4000
EVALUATOR_TEMPERATURE=0.3

# --- Preparer (turns selected news into a markdown retelling + images) ---
# Evaluator-owned storage, separate from the crawler DB (contract).
EVALUATOR_DB_PATH=/var/lib/posinus/pipeline/evaluator.sqlite3
MEDIA_DIR=/var/lib/posinus/pipeline/media
PREPARER_USER_AGENT=PositiveNewsEvaluator/0.1 (+mailto:mail@wildcar.ru)
# Selected news prepared per preparer timer run.
PREP_BATCH=5
# Same reasoning-token caveat as EVALUATOR_MAX_TOKENS; the retelling itself is longer.
PREPARER_MAX_TOKENS=4000
PREPARER_TEMPERATURE=0.7
# external_user_id of the retelling calls at the model router. A separate id from
# the evaluator's on purpose - otherwise the whole pipeline's token spend lands on
# news-evaluator. Not a DB contract string; changing it is safe.
PREPARER_ROUTER_USER_ID=news-preparer

# --- Retention (the only thing that deletes pipeline files) ---
# How long a published item keeps its pictures. A candidate that never went out
# loses them once the publisher takes it off the queue, see PUB_EXPIRE_AFTER_DAYS.
# Rows are never deleted: they are the history the operator screens are built on.
KEEP_PUBLISHED_DAYS=30

# --- Publisher (posts prepared news to the platforms) ---
# Max NEW items to start per timer run (retries of already-public items are not
# limited). Combined with PUB_MIN_INTERVAL_MINUTES this paces fresh posts.
PUB_BATCH=1
# Do not publish a NEW item more often than this (minutes). Prod runs 60 since
# 2026-07-25: the prepared backlog had reached 118 items at one post per 2 hours.
PUB_MIN_INTERVAL_MINUTES=60
# Give up on a platform after this many failed attempts and finalize the item
# best-effort, so a broken platform (e.g. a bad VK token) never blocks the queue.
PUB_MAX_ATTEMPTS=8
# A prepared item that waited this many days for its turn is taken off the queue
# («снята с очереди»): it is not news any more, and the queue is longer than this.
# Retention deletes its pictures afterwards — never before, so an item can never
# lose them while it can still be published.
PUB_EXPIRE_AFTER_DAYS=10
# Publication window: a NEW item goes out only between these local times, so a
# post never lands at 03:40 to an empty channel. Retries of an item that is
# already public finish regardless. Leave PUB_WINDOW_START empty to switch the
# window off entirely.
PUB_WINDOW_START=08:00
PUB_WINDOW_END=22:00
PUB_WINDOW_TZ=Europe/Moscow
# Request mailbox: the web UI drops run requests here and writes the `pause`
# file (the stop cock) that holds every publication. Created by deploy/install.sh.
REQUESTS_DIR=/var/lib/posinus/pipeline/requests
# Where operator notifications go: the OWNER'S OWN chat, never the public
# channel — this carries diagnostics, not posts. Empty means no notifications at
# all, which is the safe default. Get the id by writing to the bot and reading
# https://api.telegram.org/bot<token>/getUpdates.
NOTIFY_CHAT_ID=
# A platform turns ON only when its secrets are set here; leave blank to skip it.
# The publisher timer runs harmlessly (posts nothing) until at least one is set.

# Telegram channel @posinus. Token from @BotFather (the same bot used before).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003795927410
TELEGRAM_CHANNEL_USERNAME=posinus

# wildcar.org — the static MkDocs site on THIS host. The base URL is the on/off
# switch. The publisher writes pages into WILDCAR_ORG_CONTENT_DIR, touches the
# rebuild marker for posinus-wildcar-org-build.path and waits up to
# WILDCAR_ORG_WAIT_SECONDS for the page to be live. The section also carries
# rss.xml — the feed Дзен polls, which is how the news reach dzen.ru.
# NOTE: telegram links its picture from wildcar.org, so keep this on when
# TELEGRAM_BOT_TOKEN is set — without it telegram falls back to a photo upload
# with a 1024-char caption instead of the full text.
WILDCAR_ORG_BASE_URL=https://wildcar.org
WILDCAR_ORG_CONTENT_DIR=/var/lib/posinus/wildcar-org
WILDCAR_ORG_SECTION=news
WILDCAR_ORG_WAIT_SECONDS=90

# Site wildcar.ru (Эгея). Login is 'wildcar', password is the Эгея account password.
EGEYA_BASE_URL=https://wildcar.ru
EGEYA_LOGIN=wildcar
EGEYA_PASSWORD=
EGEYA_TAGS=добрые новости

# VK community wall. NOTE: photo upload needs a USER token of a group admin with
# scope photos,wall,groups (a community token fails getWallUploadServer, error 27).
# VK_GROUP_ID is the numeric community id (positive number).
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
