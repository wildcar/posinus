[Unit]
Description=Positive News Preparer (one batch)
# The router serves the model; the crawler DB must exist before we read it.
After=network-online.target model-router-mcp.service
Wants=network-online.target

[Service]
Type=oneshot
User=posinus-pipeline
Group=posinus-pipeline
SupplementaryGroups=posinus
# Group access to the crawler DB sidecar files (-wal/-shm) per the contract.
UMask=0007
# Defaults; /etc file overrides them.
Environment=PREP_BATCH=5
EnvironmentFile=/etc/posinus/pipeline.env
# Drop the operator's request first: the .path unit retriggers while the
# file exists, and a run that started already covers a second click.
ExecStartPre=-/bin/rm -f /var/lib/posinus/pipeline/requests/run-preparer
ExecStart=/usr/bin/python3 /opt/posinus/pipeline/preparer.py --limit ${PREP_BATCH}
NoNewPrivileges=true
# No PrivateTmp: writes go to /var/lib/posinus/pipeline, owned by this user.
