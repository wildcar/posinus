POSINUS_SECRET_KEY=replace-with-at-least-50-random-characters
POSINUS_DB_PATH=/var/lib/posinus/posinus.sqlite3
POSINUS_BACKUP_DIR=/var/lib/posinus/backups
POSINUS_LOG_DIR=/var/log/posinus
POSINUS_ALLOWED_HOSTS=127.0.0.1,localhost
POSINUS_CSRF_TRUSTED_ORIGINS=
POSINUS_USER_AGENT="PositiveNewsCrawler/0.1 (+mailto:operator@example.com)"
POSINUS_DEBUG=0
POSINUS_LOG_LEVEL=INFO
POSINUS_SECURE=0
POSINUS_ROUTER_MCP_URL=http://127.0.0.1:8088/mcp/
POSINUS_ROUTER_AUTH_TOKEN=fill-me
POSINUS_ROUTER_TIMEOUT_SECONDS=300
POSINUS_TRANSLATION_PROVIDER=deepseek
POSINUS_TRANSLATION_MODEL=deepseek-v4-pro
POSINUS_TRANSLATION_TIER=
POSINUS_TRANSLATION_TEMPERATURE=0.2
POSINUS_TRANSLATION_MAX_TOKENS=8192
POSINUS_MANUAL_SCORE_SELECTOR=news-evaluator
# Shared mailbox with the pipeline: the stop cock and «run now» requests are
# files here. Created by pipeline/deploy/install.sh (group posinus, setgid).
POSINUS_PIPELINE_REQUESTS_DIR=/var/lib/posinus/pipeline/requests
# The pipeline's own database, read-only from the web (group posinus).
POSINUS_PIPELINE_DB_PATH=/var/lib/posinus/pipeline/evaluator.sqlite3
POSINUS_PIPELINE_MEDIA_DIR=/var/lib/posinus/pipeline/media
# Internal Nginx location that serves those pictures; empty means Django streams
# them itself, which is right on a machine without Nginx.
POSINUS_MEDIA_ACCEL_PREFIX=/_pipeline_media
POSINUS_OPERATOR_TIMEZONE=Europe/Moscow
PLAYWRIGHT_BROWSERS_PATH=/var/lib/posinus/playwright
